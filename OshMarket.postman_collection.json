{
  "info": {
    "_postman_id": "b7e1c0a2-9f3d-4c8e-8a1b-osh-market-0002",
    "name": "Osh Market API",
    "description": "Коллекция API системы управления Ошским рынком.\n\nEnvironment-переменные:\n- base_url — базовый URL без хвостового слэша (напр. http://127.0.0.1:8080)\n- token — JWT (заполняется автоматически после Login)\n- token_exp — срок действия токена (epoch seconds, авто)\n- refresh_token — refresh-токен (бэк пока не выдаёт)\n\nАвторизация задана на уровне коллекции (Bearer {{token}}) и наследуется всеми запросами, кроме папки Auth.\n\nКак начать: выбери Environment -> выполни Auth > Login -> токен сам сохранится.\n\nТестовые аккаунты: админ 0000000000/Admin@123456; арендатор 11111111111111/Tenant@123456.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var exp = pm.environment.get('token_exp');",
          "if (exp && (Date.now() / 1000) > Number(exp)) {",
          "    console.warn('Access token истёк — выполни Auth > Login заново.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res;",
                  "try { res = pm.response.json(); } catch (e) { res = {}; }",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "if (res && res.token) {",
                  "    pm.environment.set('token', res.token);",
                  "    try {",
                  "        var part = res.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "        var payload = JSON.parse(Buffer.from(part, 'base64').toString('utf8'));",
                  "        if (payload.exp) { pm.environment.set('token_exp', payload.exp); }",
                  "    } catch (e) { console.log('JWT decode failed:', e); }",
                  "    if (res.refreshToken) { pm.environment.set('refresh_token', res.refreshToken); }",
                  "    console.log('Токен сохранён в окружение.');",
                  "} else { console.warn('В ответе нет поля token.'); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"inn\": \"0000000000\",\n  \"password\": \"Admin@123456\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "login" ] },
            "description": "Вход по ИНН + пароль. Тест-скрипт кладёт token и token_exp в окружение."
          }
        },
        {
          "name": "Forgot Password (init)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"inn\": \"0000000000\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/auth/forgot-password", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "forgot-password" ] },
            "description": "Инициировать сброс пароля. Возвращает resetToken и маскированные контакты."
          }
        },
        {
          "name": "Forgot Password - Send Code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"resetToken\": \"<resetToken>\",\n  \"method\": \"email\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/auth/forgot-password/send-code", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "forgot-password", "send-code" ] },
            "description": "Отправить 6-значный код. SMS убран — код всегда уходит на email (нужен привязанный email)."
          }
        },
        {
          "name": "Forgot Password - Verify Code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"resetToken\": \"<resetToken>\",\n  \"code\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/auth/forgot-password/verify-code", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "forgot-password", "verify-code" ] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"resetToken\": \"<resetToken>\",\n  \"newPassword\": \"NewPass@123\",\n  \"confirmPassword\": \"NewPass@123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/auth/reset-password", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "reset-password" ] }
          }
        }
      ]
    },
