              { "key": "receipt", "type": "file", "src": [], "description": "Файл чека об оплате" }
            ] },
            "url": { "raw": "{{base_url}}/api/tenant/payments", "host": [ "{{base_url}}" ], "path": [ "api", "tenant", "payments" ] },
            "description": "Отправить платёж на модерацию. Статус -> PENDING, долг не списывается."
          }
        }
