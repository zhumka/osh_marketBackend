# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# Файл .env в .gitignore и НЕ должен попадать в репозиторий.

# PostgreSQL
DB_NAME=osh_market
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT (base64-encoded secret, минимум 32 байта)
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=replace_with_base64_secret_min_32_bytes

# Mail (SMTP — для писем со сбросом пароля и доступами)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@oshmarket.kg

# SMS (провайдер не подключён — заглушка)
SMS_ENABLED=false

# MinIO (объектное хранилище: QR-коды способов оплаты и чеки)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=osh-market
